# === Redis (Vercel Marketplace 통합) ===
# Vercel 프로젝트 → Storage 탭에서 Redis 통합을 만들어 연결하면 REDIS_URL 이 자동 주입된다.
# 로컬은 `vercel env pull .env.local` 로 받는다. 아래는 형식 예시일 뿐 실제 값이 아니다.
# 이 변수가 없고 NODE_ENV!=production 이면 인메모리 KV 로 폴백한다(로컬 전용).
REDIS_URL="redis://default:EXAMPLE_ONLY@example-12345.db.redis.io:6379"

# === WebAuthn Relying Party ===
# 배포 도메인. 스킴/포트/경로 없이 등록 가능한 도메인만.
# 로컬(localhost)에서는 비워도 되며 기본값 localhost / http://localhost:3000 이 쓰인다.
WEBAUTHN_RP_ID="webtest-passkey.vercel.app"
WEBAUTHN_ORIGIN="https://webtest-passkey.vercel.app"
